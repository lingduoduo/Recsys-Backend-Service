<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>com.recsys</groupId>
  <artifactId>recsys-api</artifactId>
  <version>1.0-SNAPSHOT</version>

  <properties>
    <!-- Spark 3.5 runs reliably on Java 17 LTS. -->
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>3.3.4</spring-boot.version>
    <onnxruntime.version>1.18.0</onnxruntime.version>
    <armeria.version>1.28.4</armeria.version>
    <aws.sdk.version>2.25.70</aws.sdk.version>
    <flyway.version>10.20.1</flyway.version>
    <!-- Default: skip @Tag("load") and @Tag("docker") tests.
         Override: mvn test -DexcludedGroups="" -Dgroups=load
         Run docker tests: mvn test -DexcludedGroups=load -->
    <excludedGroups>load,docker</excludedGroups>
  </properties>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- Include .txt data files that live alongside source code -->
      <resource>
        <directory>src/main/java</directory>
        <includes>
          <include>**/*.txt</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>enforce-build-invariants</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <dependencyConvergence/>
                <requireJavaVersion>
                  <version>[17,18)</version>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <excludes>
            <exclude>com/recsys/training/embedding/**</exclude>
            <exclude>com/recsys/online/flink/**</exclude>
          </excludes>
          <!-- Mirror the main-source exclusions so flink test classes don't fail
               to compile in the default (non streaming-flink) profile. -->
          <testExcludes>
            <testExclude>com/recsys/online/flink/**</testExclude>
          </testExcludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <!-- ONNX Runtime appends to the bootstrap classpath, which disables CDS and triggers this warning.
               Disabling CDS upfront suppresses it cleanly. -->
          <argLine>-Xshare:off --add-opens=java.base/java.util=ALL-UNNAMED -Dapi.version=1.44</argLine>
          <!-- Load tests are opt-in: mvn test -Dgroups=load
               Normal test runs skip them to keep CI fast. -->
          <excludedGroups>${excludedGroups}</excludedGroups>
          <!-- Colima (macOS) exposes the Docker daemon at a non-standard socket path.
               Testcontainers needs the socket override to mount it correctly, and Ryuk
               must be disabled because Colima's VM cannot bind-mount the host socket path. -->
          <environmentVariables>
            <TESTCONTAINERS_RYUK_DISABLED>true</TESTCONTAINERS_RYUK_DISABLED>
            <TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE>/var/run/docker.sock</TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE>
            <!-- Tests reach a local, passwordless Redis. The guard in LettuceClientFactory is a
                 production control; opting out here keeps it from turning every Redis-touching
                 test into a credential-management exercise. -->
            <REDIS_ALLOW_NO_AUTH>true</REDIS_ALLOW_NO_AUTH>
          </environmentVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <configuration>
          <mainClass>com.recsys.api.rest.ModelApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <!-- Caffeine: concurrent, bounded, stats-recording in-heap cache for the embedding hot path. -->
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
      <version>3.1.8</version>
    </dependency>
    <!-- HikariCP: connection pool for the optional MySQL client. -->
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
      <version>5.1.0</version>
    </dependency>
    <!-- Armeria HTTP/2 server. -->
    <dependency>
      <groupId>com.linecorp.armeria</groupId>
      <artifactId>armeria</artifactId>
      <version>${armeria.version}</version>
    </dependency>
    <dependency>
      <groupId>com.linecorp.armeria</groupId>
      <artifactId>armeria-junit5</artifactId>
      <version>${armeria.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Spring Boot service for the two-tower ONNX serving demo. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <version>${spring-boot.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
      <version>${spring-boot.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
      <version>${spring-boot.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aop</artifactId>
      <version>${spring-boot.version}</version>
    </dependency>

    <!-- ONNX Runtime for Java user-tower inference. -->
    <dependency>
      <groupId>com.microsoft.onnxruntime</groupId>
      <artifactId>onnxruntime</artifactId>
      <version>${onnxruntime.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <version>${spring-boot.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Lettuce (Redis client) -->
    <dependency>
      <groupId>io.lettuce</groupId>
      <artifactId>lettuce-core</artifactId>
      <version>6.3.2.RELEASE</version>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-pool2</artifactId>
      <version>2.12.0</version>
    </dependency>

    <!-- Optional MySQL support. Loaded only when code opens a JDBC connection. -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>8.4.0</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
      <version>${flyway.version}</version>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
      <version>${flyway.version}</version>
    </dependency>

    <!-- Testcontainers for Redis integration tests. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mysql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>kafka</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Micrometer Prometheus exporter for Armeria metrics -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus-simpleclient</artifactId>
    </dependency>

    <!-- Kafka client for KafkaAsyncEventPublisher transport; MockProducer ships in this artifact.
         Version pinned explicitly — Spring Boot BOM is not imported in this pom's dependencyManagement. -->
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
      <version>3.7.1</version>
    </dependency>

    <!-- AWS SDK v2 SQS transport for AsyncEventPublisher and saga event publishing. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>sqs</artifactId>
      <version>${aws.sdk.version}</version>
    </dependency>

  </dependencies>

  <dependencyManagement>
    <!-- Pin Jackson to Spring Boot's version so Testcontainers/docker-java
         cannot downgrade jackson-annotations to 2.10.x (which lacks JsonIncludeProperties).
         Pin slf4j-api to 2.x so Armeria's transitive 1.7.36 cannot override Spring Boot 3/Logback 1.5. -->
    <dependencies>
      <!-- Align the transport family to Armeria and AWS SDK's shared Netty line. -->
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-bom</artifactId>
        <version>4.1.108.Final</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Align Jackson and Micrometer families to Spring Boot 3.3.4's versions. -->
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>2.17.2</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.micrometer</groupId>
        <artifactId>micrometer-bom</artifactId>
        <version>1.13.4</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>1.20.4</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-annotations</artifactId>
        <version>2.17.2</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>2.17.2</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-core</artifactId>
        <version>2.17.2</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>2.0.16</version>
      </dependency>
      <dependency>
        <groupId>commons-codec</groupId>
        <artifactId>commons-codec</artifactId>
        <version>1.15</version>
      </dependency>
      <dependency>
        <groupId>io.micrometer</groupId>
        <artifactId>micrometer-core</artifactId>
        <version>1.13.4</version>
      </dependency>
      <dependency>
        <groupId>io.micrometer</groupId>
        <artifactId>micrometer-registry-prometheus-simpleclient</artifactId>
        <version>1.13.4</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <profiles>
    <profile>
      <id>resilience</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <includes>
                <include>**/resilience/*Test.java</include>
                <include>**/loadshed/*Test.java</include>
                <include>**/gateway/UpstreamEndpointGroupsTest.java</include>
                <include>**/gateway/GatewayUpstreamHealthCheckIntegrationTest.java</include>
                <include>**/ratelimit/RedisRateLimiterTest.java</include>
                <include>**/retrieval/multichannel/*DegradationTest.java</include>
                <include>**/retrieval/multichannel/*BulkheadTest.java</include>
                <include>**/vectordb/MultiVectorMathTest.java</include>
                <include>**/vectordb/ExactMultiVectorIndexTest.java</include>
                <include>**/vectordb/CoRatedTokenBagsTest.java</include>
                <include>**/serving/SimilarMaxSimScoringTest.java</include>
                <include>**/spann/SpannConfigTest.java</include>
                <include>**/spann/KMeansTest.java</include>
                <include>**/spann/MappedPostingStoreTest.java</include>
                <include>**/spann/CentroidTableTest.java</include>
                <include>**/spann/SpannVectorIndexSearchTest.java</include>
                <include>**/spann/SpannVectorIndexUpdateTest.java</include>
                <include>**/spann/SpannVectorIndexSplitTest.java</include>
                <include>**/spann/SpannVectorIndexMergeTest.java</include>
                <include>**/spann/SpannVectorIndexCompactionTest.java</include>
                <include>**/spann/SpannVectorIndexConcurrencyTest.java</include>
                <include>**/spann/SpannVectorIndexPinnedReaderTest.java</include>
                <include>**/spann/SpannVectorIndexLifecycleTest.java</include>
                <include>**/vectordb/CandidateGeneratorSpannWiringTest.java</include>
                <include>**/outbox/OutboxRelayTest.java</include>
                <include>**/outbox/OutboxRetryPolicyTest.java</include>
                <include>**/saga/*OrchestratorTest.java</include>
                <include>**/*DegradedHeaderTest.java</include>
                <include>**/redis/ShardedTopKStoreTest.java</include>
                <include>**/redis/ShardedTopKStoreTtlConfigTest.java</include>
                <include>**/cache/LogicalExpiryEmbeddingCacheTest.java</include>
                <include>**/cache/MultiLevelEmbeddingCacheTest.java</include>
                <include>**/sharding/SequenceGeneratorGenerationTest.java</include>
                <include>**/sharding/ShardKeysTest.java</include>
                <include>**/sharding/ShardTopologySnapshotFormatTest.java</include>
                <include>**/sharding/ShardedRecordStoreAtomicWriteTest.java</include>
                <include>**/sharding/ShardedRecordStoreMergeTest.java</include>
                <include>**/sharding/ShardTopologyProviderTest.java</include>
                <include>**/sharding/ShardCursorKindTest.java</include>
                <include>**/store/ShardedRecordServiceCursorTest.java</include>
                <include>**/redis/LettuceRedisExecutorPipelineTest.java</include>
                <!-- The client half of Redis authentication. RedisAuthManifestTest below proves
                     the credential is wired in the manifests; this proves the client actually
                     puts it on the wire — including the replica URIs, which are built outside
                     uriFromEnv and carry most of the read traffic — and that a blank password
                     fails closed. Without it in the gate, a change that drops auth from the
                     client merges green and the manifest test still passes. -->
                <include>**/redis/LettuceClientFactoryTest.java</include>
                <!-- The Flink/Spark half of the same guarantee: StreamingRedisUri.from is the
                     jobs' only entry point into Redis auth, and it must build byte-for-byte the
                     same credentials LettuceClientFactory.standaloneUri builds for every service,
                     or a job and a service authenticate differently against the same server. -->
                <include>**/redis/StreamingRedisUriTest.java</include>
                <include>**/redis/RedisEmbeddingStoreTest.java</include>
                <include>**/redis/RedisEvictionPolicyManifestTest.java</include>
                <!-- The recall channel timeout bounds the caller; the Redis command timeout
                     bounds the bulkhead worker. orTimeout does not interrupt the running task
                     (measured: caller degraded at 220ms, next task waited 1790ms for a thread),
                     so an unset REDIS_TIMEOUT_MS drains the bulkhead at the 2000ms default while
                     the 200ms channel budget suggests otherwise. Three services run recall and
                     each bounded this differently; catalog-serving bounded it nowhere until
                     2026-08-17. Pure file parsing. -->
                <include>**/redis/CatalogRedisTimeoutManifestTest.java</include>
                <include>**/redis/RedisCacheStatsProbeTest.java</include>
                <include>**/redis/RedisPersistentKeyProbeTest.java</include>
                <include>**/redis/RedisReplicaLagProbeTest.java</include>
                <include>**/metrics/RedisCacheMetricsTest.java</include>
                <include>**/metrics/SplunkHecMetricsTest.java</include>
                <!-- Armeria's configureRegistry is a no-op, so nothing binds the JVM metrics
                     unless this class does; heap and GC were unscrapeable on three of four
                     services until it existed. Also pins the guard against installing a second
                     JvmGcMetrics (and therefore a second JMX listener that would double-count
                     every GC pause) on a repeat bind of the same registry. Pure unit-level, no
                     Redis, no timing. The GC-observation test
                     (metersStillReportAfterGarbageCollection, System.gc() plus a polling loop
                     for an asynchronously-delivered JMX notification) is split into
                     JvmMetricsBinderGcObservationTest and stays out of this profile
                     deliberately — the same timing dependency issue #261 burned this profile on
                     before, and the same split already applied to GcEventTrackerTest /
                     GcEventTrackerLifecycleTest. -->
                <include>**/metrics/JvmMetricsBinderTest.java</include>
                <!-- Pins the Histogram-vs-Summary shape a later alert depends on:
                     MetricCollectingService's default DistributionStatisticConfig publishes
                     client-side quantile= series only, no _bucket series, so
                     histogram_quantile(...rate(..._bucket[5m])) matches nothing against it —
                     it would sit in Prometheus looking like coverage and never fire. This is
                     the only check that a Micrometer/Armeria upgrade, or an edit to the SLO
                     boundary list, doesn't silently disarm that alert again. Pure unit-level,
                     no Redis, no Docker, no timing. -->
                <include>**/metrics/RequestDurationHistogramTest.java</include>
                <!-- Pins two Micrometer behaviours that fail silently. A duplicate queue name
                     would otherwise return the first meter and discard the second source, so one
                     queue would report another's depth with no error; and a non-positive capacity
                     would publish a utilization series that reads as healthy-and-empty for a
                     broken queue. Both are registration-time throws, so the failure is a boot
                     failure rather than a wrong number at 3am. Pure unit-level, no timing —
                     the GC-liveness half lives in QueueMetricsGcObservationTest, out of this
                     profile on purpose. -->
                <include>**/metrics/QueueMetricsTest.java</include>
                <!-- warmUp() dispatches the model preload itself, and without an explicit
                     executor CompletableFuture picks one that varies with core count: the
                     JVM-wide common pool where parallelism > 1, a thread-per-task executor
                     otherwise. Neither is wrong for a preload, but blocking the common pool
                     blocks a pool nothing else here owns, and the choice being accidental is
                     what makes it worth pinning. Overrides getRuntime, so no ONNX session is
                     built — pure dispatch, no timing, ~30ms. -->
                <include>**/model/ModelRuntimeProviderWarmUpTest.java</include>
                <!-- QueueMetricsTest above never scrapes a real Prometheus registry, so nothing
                     pinned that the four meters actually reach the wire under the names
                     RecsysQueueFillingUp/RecsysQueueRejecting query — in particular that
                     recsys.queue.rejected, a FunctionCounter, gets the _total suffix Micrometer's
                     Prometheus client appends to counters. A Micrometer upgrade that changes that
                     naming convention would disarm RecsysQueueRejecting with nothing failing.
                     Also parses prometheus-rules.yaml and asserts every recsys_queue_* identifier
                     named in an expr: is one of the names actually scraped, so a future alert on a
                     misspelled or renamed queue metric fails here instead of sitting in Prometheus
                     looking like coverage. Pure unit-level, no timing. -->
                <include>**/metrics/QueueMetricWireNamesTest.java</include>
                <!-- Three distinct causes flowed through one drop counter here: a full queue, a
                     closed publisher, and (in the Kafka subclass) an event with no usable
                     partition key. Un-separated, a malformed-key bug reads as saturation and the
                     queue-full alert fires on every rolling deploy. This pins the split. No
                     Redis, no timing — the publisher is constructed directly with a stub
                     sendBatch. -->
                <include>**/messaging/AsyncEventPublisherTest.java</include>
                <!-- The Kafka subclass is the only publisher that rejects for a reason unrelated
                     to capacity — a missing partition key — and the only one whose producer
                     config decides delivery semantics (idempotence, bounded retries). Neither is
                     covered by AsyncEventPublisherTest above. The three tests that wait on the
                     drain thread live in KafkaAsyncEventPublisherDeliveryTest and stay OUT of
                     this profile; what remains here is MockProducer and property assertions with
                     no wait. -->
                <include>**/messaging/KafkaAsyncEventPublisherTest.java</include>
                <!-- Task 4's GC/heap log emitter is built on GcEventTracker.start()/stop(); without
                     this test, a regression to the old package-private install() — or a dropped
                     idempotency guard that silently double-registers a JMX listener and
                     double-counts every GC pause fleet-wide — merges green. Pure state assertions
                     on registeredCollectorCount(): no System.gc(), no Thread.sleep, no Redis, no
                     Docker. The GC-observation half of GcEventTracker's tests stays out of this
                     profile deliberately — it waits on the JVM actually delivering a JMX
                     notification inside a sleep window, which is exactly the kind of timing
                     dependency issue #261 burned this profile on before. -->
                <include>**/jvm/GcEventTrackerLifecycleTest.java</include>
                <!-- The GC and heap-pressure events are the only memory signal that reaches
                     Splunk, and their whole correctness is that they are edge-triggered: a
                     regression to per-collection emission would flood a bounded, drop-on-full
                     HEC queue and take the ERROR events with it. Also pins the unset-heap-max
                     guard, the same -1 sentinel that defeats the Prometheus alert. No timing,
                     no JVM dependence — the emission seam is called directly. -->
                <include>**/jvm/GcEventLoggingTest.java</include>
                <include>**/metrics/ScrapeTargetManifestTest.java</include>
                <!-- ScrapeTargetManifestTest proves a series is collected at all; this proves the
                     collected series carries the job label its promtool fixtures assume. Nothing
                     but Prometheus Operator's own jobLabel default ties a fixture's job="recsys-*"
                     to the Service it claims to be, and only the annotation text depends on it —
                     a drift would still let the alert fire, just naming the wrong service in the
                     page. The second assertion pins the jobLabel-absent assumption itself, not
                     today's values, so a future ServiceMonitor adding jobLabel fails loudly
                     instead of quietly invalidating every fixture. Pure file parsing. -->
                <include>**/metrics/PromtoolJobLabelManifestTest.java</include>
                <!-- The egress counterpart to ScrapeTargetManifestTest's ingress checks. The
                     NetworkPolicy is the L3/L4 ACL the whole backend trust model rests on
                     (20_AuthN_AuthZ), and its failure mode is silence: a dropped egress rule
                     looks like a dependency outage, not a policy bug. Pure file parsing. -->
                <include>**/k8s/NetworkPolicyEgressManifestTest.java</include>
                <include>**/k8s/RedisAuthManifestTest.java</include>
                <!-- The per-service Redis ACL analogue of RedisAuthManifestTest: that test proves
                     every workload authenticates; this proves each one authenticates as its own
                     user and can write only the prefixes its code writes, not the whole keyspace.
                     Pure file parsing. -->
                <include>**/k8s/RedisAclManifestTest.java</include>
                <include>**/k8s/RedisUsernameOverlayTest.java</include>
                <!-- The operator tier's credential and the code that reads it live in different
                     files with nothing else tying them together; a service that enforces the tier
                     without the Secret rejects every operator request and says so only in a
                     startup warning. Pure file parsing. -->
                <include>**/k8s/OperatorTokenManifestTest.java</include>
                <!-- The MySQL analogue of RedisAuthManifestTest: MySqlConnectionSettings refuses
                     to construct without sslMode=VERIFY_IDENTITY when MySQL is enabled, which
                     protects a running service; this protects the deploy, so a manifest URL that
                     regresses to no sslMode fails the PR gate rather than pod start. Pure file
                     parsing. -->
                <include>**/k8s/MySqlTlsManifestTest.java</include>
                <include>**/k8s/GatewayExposureManifestTest.java</include>
                <!-- The process-boundary counterpart to the k8s auth manifest tests above: those
                     prove a workload can reach its dependencies, this proves the platform can
                     recover it. -XX:+ExitOnOutOfMemoryError is a substring in a YAML env value,
                     so nothing but this test notices it disappearing — a cluster missing it just
                     goes back to never restarting an OOM'd pod, silently. -->
                <include>**/k8s/OomPolicyManifestTest.java</include>
                <!-- The IRSA comments in k8s/ are the instructions an operator provisions IAM
                     from, and no machine applies them, so a wrong claim there fails as an
                     AccessDenied in production or as a silent over-grant. This pins the source
                     facts those comments assert — only sqs among AWS SDK v2 service clients, an
                     explicit set of SQS send call sites, and an explicit set of SQS client
                     construction sites — rather than their prose. The construction-site set is
                     the one that catches a new workload reusing an existing publisher class,
                     which is how a fourth SQS-calling workload went undocumented through two
                     reviews. It catches sends only; a non-send SQS action, a wrong workload
                     note, SDK v1 and anything outside src/main/java all stay green — see the
                     test's javadoc. Pure file parsing. -->
                <include>**/k8s/IrsaPermissionSourceFactsTest.java</include>
                <include>**/k8s/UpstreamTest.java</include>
                <!-- These two are the producer half of the data-freshness alerts.
                     ScrapeTargetManifestTest above proves the series get collected;
                     ConsistencyMetricsTest pins the exact scraped text those alerts
                     select on (a Timer is exposed as _max, never as its meter name), and
                     RedisFeatureVersionSamplerTest pins the availability semantics that
                     stop a frozen age gauge from reading as fresh. Without both in the
                     gate, a Micrometer upgrade could rename the series and silently
                     disarm every alert in the recsys.data group without failing a PR. -->
                <include>**/metrics/ConsistencyMetricsTest.java</include>
                <include>**/redis/RedisFeatureVersionSamplerTest.java</include>
                <include>**/observability/SplunkHecConfigTest.java</include>
                <include>**/observability/SplunkHecEventSerializerTest.java</include>
                <include>**/observability/SplunkHecClientTest.java</include>
                <include>**/observability/SplunkHecAppenderTest.java</include>
                <include>**/observability/SplunkLogbackWiringTest.java</include>
                <!-- User-scope authorization. The claim these tests pin is the only thing
                     standing between an end-user token and another user's data once
                     GATEWAY_COGNITO_ISSUER is set; a claim silently read as blank fails
                     closed, but a claim silently coerced from a container would not. -->
                <include>**/gateway/CognitoJwtVerifierTest.java</include>
                <include>**/gateway/GatewayPrincipalTest.java</include>
                <include>**/gateway/BackendRoutePolicyTest.java</include>
                <include>**/gateway/UserScopeAuthorizationTest.java</include>
                <!-- Enforcement half of BackendRoutePolicy: a route with no policy, or one
                     explicitly NO_PROXY, must be denied — indistinguishably from a path that was
                     never routed, or the allow-list becomes an enumeration oracle. -->
                <include>**/gateway/ProxyRoutePolicyEnforcementTest.java</include>
                <!-- The conformance half: user-scope enforcement covers a route only if the route
                     is declared, so an undeclared new route is the failure mode that matters. -->
                <include>**/gateway/BackendRouteCoverageTest.java</include>
                <!-- A '.' path segment parses differently in Armeria (preserved) and Tomcat
                     (collapsed), which made every 8080 user-scoped route bypassable by respelling
                     the path. The edge rejection is the only thing standing between that spelling
                     and the check, so it gates PRs. -->
                <include>**/gateway/GatewayPathCanonicalizationTest.java</include>
                <!-- The never-public guard is derived from BackendRoutePolicy here; this is also the
                     LLM proxy's construction-time guard against becoming a second unchecked
                     forwarding path. -->
                <include>**/gateway/GatewayAuthenticatorTest.java</include>
                <include>**/gateway/LlmProxyServiceTest.java</include>
                <include>**/gateway/LlmProxyStreamTimeoutTest.java</include>
                <include>**/gateway/LlmTokenBudgetReconciliationTest.java</include>
                <include>**/gateway/LlmTokenUsageScannerTest.java</include>
                <include>**/gateway/LlmSseKeepaliveTest.java</include>
                <include>**/gateway/LlmSseKeepaliveConfigurationTest.java</include>
                <!-- The LLM proxy's concurrency ceiling is outstanding subscriptions, not a
                     thread pool: 200 concurrent SSE streams must complete with no non-event-loop
                     thread inside the proxy and bounded JVM thread growth. Proven red against a
                     blocking-executor mutation. -->
                <include>**/gateway/LlmProxyStreamConcurrencyTest.java</include>
                <!-- Ordinary proxy responses stream rather than buffer. Two invariants gate here:
                     the first chunk must reach the caller before the upstream completes, and a
                     cancelled request must settle its circuit permit neutrally. Counting a
                     cancellation as a failure let an unauthenticated caller open a public route's
                     circuit with five hang-ups; both tests were proven red against that. -->
                <include>**/gateway/GatewayResponseStreamingTest.java</include>
                <include>**/gateway/GatewayUpstreamResponseTest.java</include>
                <include>**/auth/AdminTokenGuardTest.java</include>
                <include>**/serving/EmbeddingSeedRepairTest.java</include>
                <include>**/serving/CacheKeyParamTest.java</include>
                <include>**/serving/CatalogCacheHeadersTest.java</include>
                <include>**/serving/SimilarCacheHeadersTest.java</include>
                <include>**/serving/CdnQueryNormalizationConformanceTest.java</include>
                <!-- The only path that sends an application user identifier to a third party.
                     Pins that PostHog receives a salted digest and never the userId itself. -->
                <include>**/featureflags/providers/PostHogFeatureFlagProviderTest.java</include>
                <!-- Pins RECOMMENDATION_CURSOR_ACCEPT_LEGACY=false. The legacy cursor path
                     validates no signature, expiry, user binding or query fingerprint, and a
                     permissive default is how it reached production config unnoticed. -->
                <include>**/pagination/RecommendationPaginationConfigTest.java</include>
                <!-- Not resilience tests. This profile is what the PR gate runs
                     (.github/workflows/resilience-pr.yml), so it is the only place a
                     deterministic check can block a merge. Everything listed here is pure
                     unit-level — no Redis, no Docker, no timing — so it is safe. Note that
                     @Tag("docker") tests are excluded by <excludedGroups> below regardless
                     of any <include> above, so listing one would imply coverage the gate
                     does not actually provide. -->
                <include>**/docs/DocumentationIndexTest.java</include>
                <include>**/docs/DocumentedMechanismTest.java</include>
                <!-- The MySQL connection carries catalog rows, outbox events and saga state.
                     Connector/J defaults to a mode that falls back to plaintext without error,
                     so the transport requirement is only real if something pins it. -->
                <include>**/persistence/MySqlConnectionSettingsTest.java</include>
                <!-- The classification is the single definition of which requests reach Splunk,
                     shared by the Armeria decorator and the Spring interceptor so four services
                     cannot disagree. Pins two things the gate must not lose: 4xx does not
                     trigger an event (it is caller-controlled, and a bounded drop-on-full HEC
                     queue makes that a remote way to discard the ERROR events), and no MDC field
                     name collides with SplunkHecEventSerializer's reserved set, where a
                     collision is silently dropped rather than reported. Pure unit-level. -->
                <include>**/observability/RequestOutcomeTest.java</include>
                <!-- The decorator half: emits for slow and 5xx, stays silent otherwise, and
                     clears MDC on the pooled event loop thread it runs on. A leaked MDC entry
                     would attach itself to unrelated later log lines from that thread, which
                     poisons exactly the searches this feature exists to enable. In-process
                     Armeria server, no Redis, no Docker. -->
                <include>**/observability/SlowRequestLoggerTest.java</include>
                <!-- The model service's half of the slow-request event. Separate from the
                     Armeria decorator because it is a different mechanism (HandlerInterceptor,
                     Tomcat threads) reaching the same contract, and it pins the one thing the
                     Armeria side gets for free: route must be the matched pattern, not the raw
                     URI, or every request with an id in the path becomes its own route value.
                     MockHttpServletRequest only, no container. -->
                <include>**/config/SlowRequestInterceptorTest.java</include>
                              <!-- ONNX serving hardening (PR #309). Five tests that pin the properties an
                     unverified model bundle or a mis-wired variant would break, chosen for the
                     profile because none touches ONNX Runtime, Redis, Docker, or the clock:
                     the contract tests run against a Mockito session adapter, not a real model;
                     the manifest/path-safety tests use @TempDir files (the one symlink case
                     aborts via Assumptions where links are unsupported); the manifest test is
                     pure YAML/text parsing; the two metric/resolver tests use a fixed LongSupplier
                     clock. MultiChannelRecallServiceTest is deliberately NOT here — its
                     cancellation cases wait on real 100-150ms deadlines, the timing dependency
                     issue #261 burned this profile on — and UserTowerInferenceServiceTest loads
                     the real ONNX model, so it stays in the default suite only. -->
                <include>**/model/ModelArtifactManifestTest.java</include>
                <include>**/retrieval/UserTowerInferenceContractTest.java</include>
                <include>**/experiment/VariantRuntimeResolverTest.java</include>
                <include>**/retrieval/multichannel/RecallTaskMetricsTest.java</include>
                <include>**/k8s/ModelServingManifestTest.java</include>
</includes>
              <excludedGroups>load,docker</excludedGroups>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
